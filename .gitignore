# the composer package lock file and install directory
# Commit your application's lock file http://getcomposer.org/doc/01-basic-usage.md#composer-lock-the-lock-file
# You may choose to ignore a library lock file http://getcomposer.org/doc/02-libraries.md#lock-file
# /composer.lock
/fuel/vendor

# FuelPHP本体のドキュメント(fuel/docs)用の除外設定は削除した。
# composer.jsonから fuel/docs を外しておりインストールされないため。
# /docs/ は要件定義などのプロジェクト資料を置く場所として使う。

# you may install these packages with `oil package`.
# http://fuelphp.com/docs/packages/oil/package.html
# /fuel/packages/auth/
# /fuel/packages/email/
# /fuel/packages/oil/
# /fuel/packages/orm/
# /fuel/packages/parser/

# dynamically generated files
/fuel/app/logs/*/*/*
/fuel/app/cache/*/*
/fuel/app/config/crypt.php

# database configuration (contains credentials)
/fuel/app/config/db.php
/fuel/app/config/development/db.php
/fuel/app/config/production/db.php
/fuel/app/config/staging/db.php
/fuel/app/config/test/db.php

# 環境変数（各自ローカルで作成する。値はコミットしない）
docker/.env
